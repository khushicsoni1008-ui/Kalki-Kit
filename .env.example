# ==========================================================================
# KALKI-KIT ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your own values. Never commit .env.
# ==========================================================================

# Port for the Node.js server
PORT=3000

# Google Gemini API key (get one at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred Gemini model. If it is busy or out of quota, the server tries other models automatically.
GEMINI_MODEL=gemini-3.8-flash

# Optional: extra web origins allowed to call the API (comma separated).
# Not needed when you open the app at http://localhost:3000
# ALLOWED_ORIGINS=https://your-site.example

# Optional: set to true when running behind a reverse proxy (nginx, Cloudflare) so rate limits use the visitor's real IP
# TRUST_PROXY=true
