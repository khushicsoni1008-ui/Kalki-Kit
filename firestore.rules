rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user can access only their own history. Guest tokens are
    // not Firebase Authentication users and therefore cannot access Firestore.
    match /users/{userId}/checks/{checkId} {
      allow read, delete: if request.auth != null
                          && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.uid == userId
                            && request.resource.data.id == checkId;
    }
  }
}